# Environment-variable reference. Nothing here is required, and Python commands
# deliberately do not auto-load `.env` files. Export the values you want in the
# shell before running a command. On POSIX shells, a copied `.env` can be loaded
# with `set -a; . ./.env; set +a`. In PowerShell, assign the corresponding
# `$env:NAME = "value"` entries. `.env` itself is gitignored.

# Rank count used to size OMP_NUM_THREADS when activate.sh/activate.ps1 or
# conftest.py configures the environment. Do not exceed the available CPU cores
# for routine Tier-1 work.
DTFS_NPROC=2

# Process-group timeout in seconds. Lower it while debugging so a deadlock
# fails in thirty seconds instead of five minutes.
DTFS_TIMEOUT_S=300

# Where bench/ writes plots and writeups. Relative paths are repo-relative.
DTFS_RUNS_DIR=runs

# ---------------------------------------------------------------------------
# Debugging. All off by default because they are extremely verbose.
# ---------------------------------------------------------------------------

# DETAIL logs every collective and checks that ranks agree on shapes and order.
# This is the first thing to turn on when a run hangs.
# TORCH_DISTRIBUTED_DEBUG=DETAIL

# NCCL only, so Tier 2 only. TUNING reports algorithm and protocol selection;
# COLL instead reports collective operations.
# NCCL_DEBUG=INFO
# NCCL_DEBUG_SUBSYS=TUNING

# Flight Recorder: keep a ring buffer of recent collectives and dump it when
# the watchdog times out. Setting the buffer alone does not request a dump.
# TORCH_NCCL_TRACE_BUFFER_SIZE=1000
# TORCH_NCCL_DUMP_ON_TIMEOUT=1

# ---------------------------------------------------------------------------
# Opt-in extras
# ---------------------------------------------------------------------------

# TinyStories responses larger than 500 MiB are rejected. Off unless requested.
# DTFS_ALLOW_TINYSTORIES=0
